services:
    postgres:
        image: postgres:13
        environment:
            POSTGRES_USER: root
            POSTGRES_PASSWORD: 123456
            POSTGRES_DB: ny_taxi
        volumes:
            - postgres-db-volume: /var/lib/postgresql/data
        healthcheck:
            test: ["CMD", "pg_isready", "-U", "ny_taxi"]
            interval: 5s
            retries: 5
        restart: always

